# =============================================================================
# PromoApp - Przykładowa konfiguracja zmiennych środowiskowych
# Skopiuj ten plik jako .env i uzupełnij własnymi wartościami.
# =============================================================================

# --- Środowisko i serwer ---
NODE_ENV=development
PORT=3001
# Adres frontendu (CORS oraz przekierowanie po logowaniu Google OAuth)
CLIENT_URL=http://localhost:5173

# --- Baza danych PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promo_app
# Ustaw "true" na produkcji (np. Render, Railway, Neon, Supabase), jeśli DB wymaga SSL
DATABASE_SSL=false

# --- Sesja Express (connect-pg-simple, 30 dni) ---
# Wygeneruj losowy ciąg np. poleceniem: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=zmien-to-na-dlugi-losowy-ciag-znakow-min-64-bajty

# --- Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=twoj-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=twoj-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Google Gemini AI (@google/genai) ---
GEMINI_API_KEY=twoj-klucz-api-gemini
GEMINI_MODEL=gemini-2.5-flash
